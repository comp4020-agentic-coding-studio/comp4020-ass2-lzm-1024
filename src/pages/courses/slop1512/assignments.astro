---
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import WebDesignCourseLayout from "../../../components/WebDesignCourseLayout.astro";
import { siteConfig } from "../../../site-config";
import { webAssignments, webCourse } from "../../../data/slop1512";
---

<BaseLayout title={`Assignments — ${webCourse.code} — ${siteConfig.name}`} {...siteConfig}>
  <WebDesignCourseLayout title="Assignments" description="Four connected assignments assess structure, visual design, accessible interaction and a final multi-page publication.">
    <div class="assignment-list">{webAssignments.map((assignment, index) => <article><header><div><h2>{assignment.title}</h2><p>Due {assignment.due}</p></div><strong>{assignment.weight}</strong></header><p>{assignment.brief}</p><h3>What you submit</h3><p>{assignment.submit}</p><h3>Marking focuses on</h3><ul>{assignment.criteria.map((criterion) => <li>{criterion}</li>)}</ul><p class="brief-note"><a href={`/assessment-briefs/slop1512/SLOP1512-assignment-${index + 1}-brief.pdf`} download>Download assignment requirements PDF</a></p></article>)}</div>
  </WebDesignCourseLayout>
</BaseLayout>

<style>
  .assignment-list { display: grid; gap: 1.25rem; max-width: 62rem; margin-top: 2rem; }.assignment-list article { padding: 1.3rem; border: 1px solid var(--at-border); border-radius: 0.55rem; }.assignment-list header { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--at-border); }.assignment-list h2 { margin: 0; font-size: 1.35rem; }.assignment-list header p { color: var(--at-text-secondary); }.assignment-list header strong { color: var(--at-primary); font-size: 1.25rem; white-space: nowrap; }.assignment-list h3 { margin-bottom: 0.25rem; font-size: 1rem; }.assignment-list ul { margin-top: 0.35rem; padding-left: 1.2rem; line-height: 1.6; }.brief-note { margin: 1rem -1.3rem -1.3rem; padding: 0.8rem 1.3rem; color: var(--at-text-secondary); background: var(--at-bg-alt); font-size: 0.9rem; }
</style>
