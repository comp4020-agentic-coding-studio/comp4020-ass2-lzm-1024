---
import PageLayout from "../layouts/PageLayout.astro";
import DashboardOverview from "../components/DashboardOverview.astro";
import UpcomingAssignments from "../components/UpcomingAssignments.astro";
import { courseMeta } from "../course-config";
---

<PageLayout title={`${courseMeta.code}: ${courseMeta.title}`} description={courseMeta.description}>
  <div class="dashboard-grid">
    <div class="dashboard-main">
      <DashboardOverview />
    </div>
    <div class="dashboard-rail">
      <UpcomingAssignments />
    </div>
  </div>
</PageLayout>

<style>
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--at-spacing-xl, 2rem);
  }

  /* Keyed off the content column's own width (see PageLayout.astro's
     `container: course-content`), not the viewport — the persistent 16rem
     sidebar means viewport width alone overstates how much room is actually
     left for this grid, which is what let the rail crowd the main column
     down to an unreadable sliver. */
  @container course-content (min-width: 48rem) {
    .dashboard-grid {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: start;
    }
  }
</style>
