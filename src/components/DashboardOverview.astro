---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../course-config";
import { courseWeeks, roleLabels, sortByDue, sortByWeekThenDate, sortPeople } from "../lib/course-content";
import { formatCourseDate } from "../lib/dates";
import CoursePanel from "./CoursePanel.astro";

const sessions = sortByWeekThenDate(await getPublishedCollection("sessions"));
const lectures = sortByWeekThenDate(await getPublishedCollection("lectures"));
const assessments = sortByDue(await getPublishedCollection("assessments"));
const people = sortPeople(await getPublishedCollection("people"));
const weeks = courseWeeks(sessions, lectures, assessments);

const firstWeekSessions = sessions.filter((s) => s.data.week === weeks[0]);
const firstWeekLectures = lectures.filter((l) => l.data.week === weeks[0]);

const teachingTeamPreview = people.slice(0, 4);
---

<div class="dashboard-overview">
  <CoursePanel title="Course overview">
    <p>{courseMeta.description}</p>
    {
      courseMeta.tags.length > 0 && (
        <ul class="dashboard-tags" aria-label="Course tags">
          {courseMeta.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </CoursePanel>

  <CoursePanel title="Course modules overview">
        <p>
          {weeks.length} week{weeks.length === 1 ? "" : "s"} of material are scheduled so far. Browse the
          full breakdown on the <a href={withBase("/sessions/")}>Modules</a> page.
        </p>
        {(firstWeekSessions.length > 0 || firstWeekLectures.length > 0) && (
          <p>
            Starts with Week {weeks[0]}:{" "}
            {[...firstWeekLectures, ...firstWeekSessions].map((item, i, arr) => (
              <>
                <a href={withBase(`/${item.collection}/${item.id}/`)}>{item.data.title}</a>
                {i < arr.length - 1 ? ", " : ""}
              </>
            ))}
          </p>
        )}
  </CoursePanel>

  <CoursePanel title="Start here">
    <p>
      This is a hands-on foundation course. You can work with a phone or camera; expensive equipment is not required.
      Each week combines a short lecture, a making task and critique.
    </p>
    <p>
      By the end of the course, you will be able to plan a short visual story, record purposeful image and sound,
      edit a clear sequence, and explain the ethical choices behind publication.
    </p>
    <p>
      Begin with <a href={withBase("/lectures/week-01/")}>Week 1: Seeing before shooting</a>, then complete the
      field exercise in the first module.
    </p>
    <p>
      Plan for about 2 hours of class and 3–4 hours of independent viewing, shooting, editing or reflection each week.
    </p>
  </CoursePanel>

  <CoursePanel title="Learning outcomes">
    <ol>
      <li>Plan a short visual story for a defined audience and production context.</li>
      <li>Record purposeful image and sound using a phone or camera safely and responsibly.</li>
      <li>Edit a clear, captioned short video using deliberate structure, pace and continuity.</li>
      <li>Analyse creative choices, give useful critique and document consent, attribution and revision.</li>
    </ol>
  </CoursePanel>

  <CoursePanel title="Course modules">
    <ul class="dashboard-week-list">
      {
        weeks.map((week) => (
          <li>
            <a href={withBase(`/sessions/#week-${week}`)}>Week {week}</a>
            {sessions.find((s) => s.data.week === week)?.data.title && (
              <span class="dashboard-week-title"> — {sessions.find((s) => s.data.week === week)?.data.title}</span>
            )}
          </li>
        ))
      }
    </ul>
  </CoursePanel>

  <CoursePanel title="Recent assignments">
    {
      assessments.length > 0 ? (
        <ul class="dashboard-assessment-list">
          {assessments.slice(0, 5).map((assessment) => (
            <li>
              <a href={withBase(`/assessments/${assessment.id}/`)}>{assessment.data.title}</a>
              <span class="dashboard-assessment-meta">
                Due {formatCourseDate(assessment.data.due)} · {assessment.data.weight}%
                {assessment.data.draft && " · Draft"}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p>No assignments published yet.</p>
      )
    }
  </CoursePanel>

  <CoursePanel title="Teaching team">
    {
      teachingTeamPreview.length > 0 ? (
        <ul class="dashboard-people-list">
          {teachingTeamPreview.map((person) => (
            <li>
              <a href={withBase(`/people/${person.id}/`)}>{person.data.title}</a>
              {person.data.role && roleLabels[person.data.role] && (
                <span class="dashboard-people-role"> · {roleLabels[person.data.role]}</span>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p>No teaching team members published yet.</p>
      )
    }
  </CoursePanel>
</div>

<style>
  .dashboard-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .dashboard-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .dashboard-week-label {
    margin: 0;
    font-weight: 700;
    color: var(--at-text-secondary);
  }

  .dashboard-week-list,
  .dashboard-assessment-list,
  .dashboard-people-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dashboard-week-title {
    color: var(--at-text-secondary);
  }

  .dashboard-assessment-meta,
  .dashboard-people-role {
    display: block;
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  .dashboard-people-role {
    display: inline;
  }
</style>
