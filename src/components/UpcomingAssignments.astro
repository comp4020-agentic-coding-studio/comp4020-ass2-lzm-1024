---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { sortByDue, sortByWeekThenDate } from "../lib/course-content";
import { formatCourseDate, formatCourseDateTime } from "../lib/dates";
import CoursePanel from "./CoursePanel.astro";

const assessments = sortByDue(await getPublishedCollection("assessments"));
const sessions = sortByWeekThenDate(await getPublishedCollection("sessions"));
const lectures = sortByWeekThenDate(await getPublishedCollection("lectures"));

const assignmentSchedule = assessments.slice(0, 3);
const courseSchedule = sortByWeekThenDate([...sessions, ...lectures]).slice(0, 3);
---

<div class="upcoming-rail">
  <CoursePanel title="Assignment schedule" headingLevel="h2">
    {
      assignmentSchedule.length > 0 ? (
        <ul class="rail-list">
          {assignmentSchedule.map((assessment) => (
            <li>
              <a href={withBase(`/assessments/${assessment.id}/`)}>{assessment.data.title}</a>
              <span class="rail-meta">Due {formatCourseDateTime(assessment.data.due)}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rail-empty">No assessments have been published yet.</p>
      )
    }
  </CoursePanel>

  <CoursePanel title="Course schedule" headingLevel="h2">
    {
      courseSchedule.length > 0 ? (
        <ul class="rail-list">
          {courseSchedule.map((item) => (
            <li>
              <a href={withBase(`/${item.collection}/${item.id}/`)}>{item.data.title}</a>
              <span class="rail-meta">
                Week {item.data.week} · {formatCourseDate(item.data.date)}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rail-empty">No teaching activities have been published yet.</p>
      )
    }
  </CoursePanel>

  <CoursePanel title="Quick links" headingLevel="h2">
    <ul class="rail-list rail-links">
      <li><a href={withBase("/sessions/")}>Modules</a></li>
      <li><a href={withBase("/lectures/")}>Lectures</a></li>
      <li><a href={withBase("/assessments/")}>Assignments</a></li>
      <li><a href={withBase("/people/")}>People</a></li>
      <li><a href={withBase("/policies/")}>Policies</a></li>
    </ul>
  </CoursePanel>
</div>

<style>
  .rail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .rail-list li {
    display: flex;
    flex-direction: column;
  }

  .rail-meta {
    color: var(--at-text-secondary);
    font-size: 0.85rem;
  }

  .rail-empty {
    margin: 0;
    color: var(--at-text-secondary);
  }

  .rail-links {
    gap: 0.4rem;
  }
</style>
