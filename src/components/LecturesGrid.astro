---
import { getEntries } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { sortByWeekThenDate } from "../lib/course-content";
import { formatCourseDate } from "../lib/dates";

const lectures = sortByWeekThenDate(await getPublishedCollection("lectures"));
const teachersByLecture = await Promise.all(
  lectures.map((lecture) => (lecture.data.teachers ? getEntries(lecture.data.teachers) : Promise.resolve([]))),
);
---

<ul class="lectures-list">
  {
    lectures.map((lecture, i) => (
      <li class="lecture-row">
        <p class="lecture-meta">
          <span class="lecture-week">Week {lecture.data.week}</span>
          <span>{formatCourseDate(lecture.data.date)}</span>
        </p>
        <a class="lecture-title" href={withBase(`/lectures/${lecture.id}/`)}>
          {lecture.data.title}
        </a>
        {lecture.data.description && <p class="lecture-description">{lecture.data.description}</p>}
        <p class="lecture-footer">
          {teachersByLecture[i].length > 0 && (
            <span class="lecture-teachers">{teachersByLecture[i].map((t) => t.data.title).join(", ")}</span>
          )}
          {lecture.data.slides && <a href={withBase(lecture.data.slides)}>View slides</a>}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .lectures-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .lecture-row {
    padding: 1rem 0;
    border-block-end: 1px solid var(--at-divider, var(--at-border));
  }

  .lecture-row:first-child {
    padding-block-start: 0;
  }

  .lecture-meta {
    margin: 0;
    display: flex;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--at-text-secondary);
  }

  .lecture-week {
    font-weight: 700;
  }

  .lecture-title {
    display: inline-block;
    margin-block-start: 0.25rem;
    font-weight: 600;
    font-size: 1.05rem;
  }

  .lecture-description {
    margin: 0.35rem 0 0;
    color: var(--at-text-secondary);
  }

  .lecture-footer {
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.9rem;
  }
</style>
